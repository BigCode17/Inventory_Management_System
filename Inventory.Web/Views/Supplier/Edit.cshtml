@model Inventory.Web.Models.Supplier

@{
    ViewData["Title"] = "Edit Supplier Details";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Edit Supplier Details</h1>
        <p class="page-subtitle text-muted">Update contact details and information for supplier: @Model.Name</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-custom btn-custom-light">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<!-- Main Form Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <!-- Supplier / Company Name -->
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label-custom fw-semibold mb-1">Supplier / Company Name</label>
                    <input asp-for="Name" class="form-control-custom" placeholder="Enter supplier name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Contact Person -->
                <div class="col-md-6">
                    <label asp-for="ContactPerson" class="form-label-custom fw-semibold mb-1">Contact Person</label>
                    <input asp-for="ContactPerson" class="form-control-custom" placeholder="Enter contact person name" />
                    <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                </div>

                <!-- Phone Number -->
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label-custom fw-semibold mb-1">Phone Number</label>
                    <input asp-for="Phone" class="form-control-custom" placeholder="Enter phone number" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <!-- Email Address -->
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label-custom fw-semibold mb-1">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control-custom" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <!-- Form Buttons -->
            <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn-custom btn-custom-light">Cancel</a>
                <button type="submit" class="btn-custom btn-custom-primary">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}