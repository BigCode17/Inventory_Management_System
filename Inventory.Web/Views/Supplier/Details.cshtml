@model Inventory.Web.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Supplier Details</h1>
        <p class="page-subtitle text-muted">Review contact information and profile details for @Model.Name.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-custom btn-custom-light">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<!-- Main Details Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center border border-primary-subtle" style="width: 64px; height: 64px;">
                <i class="bi bi-building fs-3"></i>
            </div>
            <div>
                <h3 class="mb-1 fw-bold">@Model.Name</h3>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">Active Supplier</span>
            </div>
        </div>

        <hr class="text-muted my-3" />

        <dl class="row mb-0 gy-3">
            <dt class="col-sm-3 text-muted">Contact Person</dt>
            <dd class="col-sm-9 fw-semibold">@Model.ContactPerson</dd>

            <dt class="col-sm-3 text-muted">Phone Number</dt>
            <dd class="col-sm-9 fw-semibold">
                <i class="bi bi-telephone text-muted me-1"></i>@Model.Phone
            </dd>

            <dt class="col-sm-3 text-muted">Email Address</dt>
            <dd class="col-sm-9 fw-semibold text-break">
                <i class="bi bi-envelope text-muted me-1"></i>@Model.Email
            </dd>
        </dl>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn-custom btn-custom-light">Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-custom btn-custom-primary">
                <i class="bi bi-pencil me-1"></i>Edit Supplier
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-3 py-2 rounded-2 fw-semibold">
                <i class="bi bi-trash me-1"></i>Delete
            </a>
        </div>
    </div>
</div>