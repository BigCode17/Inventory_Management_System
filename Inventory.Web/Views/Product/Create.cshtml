@model Inventory.Web.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Create Product</h1>
        <p class="page-subtitle text-muted">Add a new product to your inventory system.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-custom btn-custom-light">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<!-- Main Form Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <!-- Product Name -->
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label-custom fw-semibold mb-1"></label>
                    <input asp-for="Name" class="form-control-custom" placeholder="Enter product name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- SKU -->
                <div class="col-md-6">
                    <label asp-for="SKU" class="form-label-custom fw-semibold mb-1"></label>
                    <input asp-for="SKU" class="form-control-custom" placeholder="Enter SKU" />
                    <span asp-validation-for="SKU" class="text-danger small"></span>
                </div>

                <!-- Price -->
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label-custom fw-semibold mb-1"></label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control-custom" placeholder="0.00" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <!-- Stock Quantity -->
                <div class="col-md-6">
                    <label asp-for="StockQuantity" class="form-label-custom fw-semibold mb-1"></label>
                    <input asp-for="StockQuantity" type="number" class="form-control-custom" placeholder="Enter initial quantity" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <!-- Category -->
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label-custom fw-semibold mb-1">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select-custom">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <!-- Supplier -->
                <div class="col-md-6">
                    <label asp-for="SupplierId" class="form-label-custom fw-semibold mb-1">Supplier</label>
                    <select asp-for="SupplierId" asp-items="ViewBag.SupplierId" class="form-select-custom">
                        <option value="">-- Select Supplier --</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                </div>

                <!-- Product Image -->
                <div class="col-12">
                    <label class="form-label-custom fw-semibold mb-1">Product Image</label>
                    <input type="file" name="imageFile" class="form-control-custom" accept="image/*" />
                </div>
            </div>

            <!-- Form Buttons -->
            <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn-custom btn-custom-light">Cancel</a>
                <button type="submit" class="btn-custom btn-custom-primary">
                    <i class="bi bi-plus-lg me-1"></i>Save Product
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}