@model Inventory.Web.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Product Details</h1>
        <p class="page-subtitle text-muted">Review full specification and stock status for @Model.Name.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-custom btn-custom-light">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<!-- Main Details Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="row g-4 align-items-center">
            <!-- Product Image Section -->
            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Name" class="rounded border shadow-sm img-fluid" style="max-height: 250px; width: 100%; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded bg-light border d-flex flex-column align-items-center justify-content-center text-secondary py-5">
                        <i class="bi bi-image fs-1 mb-2 text-muted"></i>
                        <span>No Image Available</span>
                    </div>
                }
            </div>

            <!-- Product Specs -->
            <div class="col-md-8">
                <h3 class="fw-bold mb-3">@Model.Name</h3>
                <hr class="text-muted my-3" />

                <dl class="row mb-0 gy-3">
                    <dt class="col-sm-4 text-muted">SKU Code</dt>
                    <dd class="col-sm-8 fw-semibold font-monospace">@Model.SKU</dd>

                    <dt class="col-sm-4 text-muted">Unit Price</dt>
                    <dd class="col-sm-8 fw-semibold text-success fs-5">@Model.Price.ToString("C")</dd>

                    <!-- استخدام الـ Tag Helper هنا -->
                    <dt class="col-sm-4 text-muted">Stock Quantity</dt>
                    <dd class="col-sm-8 fw-semibold">
                        <stock-status quantity="@Model.StockQuantity"></stock-status>
                    </dd>

                    <dt class="col-sm-4 text-muted">Category</dt>
                    <dd class="col-sm-8 fw-semibold">@(Model.Category?.Name ?? "N/A")</dd>

                    <dt class="col-sm-4 text-muted">Supplier</dt>
                    <dd class="col-sm-8 fw-semibold">@(Model.Supplier?.Name ?? "N/A")</dd>
                </dl>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn-custom btn-custom-light">Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-custom btn-custom-primary">
                <i class="bi bi-pencil me-1"></i>Edit Product
            </a>
        </div>
    </div>
</div>