@model IEnumerable<Inventory.Web.Models.Product>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Products";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1 class="page-title">Products</h1>
        <p class="page-subtitle">Manage your product inventory and details.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn-custom btn-custom-primary">
            <i class="bi bi-plus-lg"></i>Add New Product
        </a>
    </div>
</div>

<!-- Main Card Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <!-- Search and Filter Form -->
        <form asp-action="Index" method="get" class="row g-3 mb-4">
            <div class="col-lg-4">
                <label class="visually-hidden" for="product-search">Search products</label>
                <input id="product-search"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control-custom"
                       placeholder="Search by name or SKU..." />
            </div>
            <div class="col-lg-3">
                <select name="categoryId"
                        class="form-select-custom"
                        asp-items="@ViewBag.CategoryId">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-lg-3">
                <select name="supplierId"
                        class="form-select-custom"
                        asp-items="@ViewBag.SupplierId">
                    <option value="">All suppliers</option>
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn-custom btn-custom-primary flex-grow-1">
                    <i class="bi bi-search"></i>Search
                </button>
                <a asp-action="Index" class="btn-custom btn-custom-light" aria-label="Reset filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>

        <!-- Products Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Category</th>
                        <th>Supplier</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-box-seam fs-3 d-block mb-2"></i>No products match the selected criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath"
                                                 class="rounded"
                                                 width="40"
                                                 height="40"
                                                 alt="@item.Name"
                                                 style="object-fit:cover" />
                                        }
                                        else
                                        {
                                            <span class="rounded bg-light text-secondary d-inline-flex align-items-center justify-content-center"
                                                  style="width:40px;height:40px">
                                                <i class="bi bi-image"></i>
                                            </span>
                                        }
                                        <span class="fw-semibold">@item.Name</span>
                                    </div>
                                </td>
                                <td>@item.SKU</td>
                                <td>@item.Price.ToString("C")</td>
                                <td>
                                    <!-- تم إضافة الـ Tag Helper هنا -->
                                    <stock-status quantity="@item.StockQuantity"></stock-status>
                                </td>
                                <td>@item.Category?.Name</td>
                                <td>@item.Supplier?.Name</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="table-btn-action" title="View @item.Name">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="table-btn-action" title="Edit @item.Name">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="table-btn-action delete" title="Delete @item.Name">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 0)
        {
            var currentPage = (int)ViewBag.CurrentPage;
            var totalPages = (int)ViewBag.TotalPages;
            var prevDisabled = currentPage <= 1 ? "disabled" : "";
            var nextDisabled = currentPage >= totalPages ? "disabled" : "";

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-categoryId="@ViewBag.CategoryIdSelected"
                   asp-route-supplierId="@ViewBag.SupplierIdSelected"
                   class="btn btn-outline-secondary @prevDisabled">
                    Previous
                </a>

                <span class="text-muted small">
                    Page @currentPage of @totalPages
                </span>

                <a asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-categoryId="@ViewBag.CategoryIdSelected"
                   asp-route-supplierId="@ViewBag.SupplierIdSelected"
                   class="btn btn-outline-secondary @nextDisabled">
                    Next
                </a>
            </div>
        }
    </div>
</div>