@model IEnumerable<Inventory.Web.Models.Transaction>

@{
    ViewData["Title"] = "Transactions Log";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Transactions Log</h1>
        <p class="page-subtitle text-muted">Track system activity, inventory updates, and product history.</p>
    </div>
</div>

<!-- Main Card Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <!-- Search Form -->
        <form asp-action="Index" method="get" class="row g-3 mb-4">
            <div class="col-lg-10">
                <label class="visually-hidden" for="transaction-search">Search transactions</label>
                <input id="transaction-search" 
                       name="searchString" 
                       value="@ViewData["CurrentSearch"]" 
                       class="form-control-custom" 
                       placeholder="Search by product name or transaction details..." />
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn-custom btn-custom-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a asp-action="Index" class="btn-custom btn-custom-light" aria-label="Reset filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>

        <!-- Transactions Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Action Type</th>
                        <th>Product</th>
                        <th>Old Qty</th>
                        <th>New Qty</th>
                        <th>Details</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-journal-text fs-3 d-block mb-2"></i>No transaction logs available.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-clock text-muted"></i>
                                        <span>@item.TransactionDate.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                </td>
                                <td>
                                    @switch (item.ActionType)
                                    {
                                        case Inventory.Web.Models.ActionType.Created:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Created</span>
                                            break;
                                        case Inventory.Web.Models.ActionType.QuantityChanged:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1">Quantity Updated</span>
                                            break;
                                        case Inventory.Web.Models.ActionType.Deleted:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">Deleted</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Updated</span>
                                            break;
                                    }
                                </td>
                                <td class="fw-semibold">@item.ProductName</td>
                                <td>@(item.OldQuantity?.ToString() ?? "-")</td>
                                <td>@(item.NewQuantity?.ToString() ?? "-")</td>
                                <td class="text-muted small">@item.Details</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="table-btn-action" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (ViewData["PageIndex"] != null && ViewData["TotalPages"] != null)
        {
            var pageIndex = (int)ViewData["PageIndex"]!;
            var totalPages = (int)ViewData["TotalPages"]!;
            var prevDisabled = pageIndex <= 1 ? "disabled" : "";
            var nextDisabled = pageIndex >= totalPages ? "disabled" : "";

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-action="Index" 
                   asp-route-pageNumber="@(pageIndex - 1)" 
                   asp-route-searchString="@ViewData["CurrentSearch"]" 
                   class="btn-custom btn-custom-light @prevDisabled">
                    <i class="bi bi-chevron-left me-1"></i>Previous
                </a>
                
                <span class="text-muted small">
                    Page @pageIndex of @totalPages
                </span>
                
                <a asp-action="Index" 
                   asp-route-pageNumber="@(pageIndex + 1)" 
                   asp-route-searchString="@ViewData["CurrentSearch"]" 
                   class="btn-custom btn-custom-light @nextDisabled">
                    Next<i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>
        }
    </div>
</div>