@page
@model Inventory.Web.Pages.Category.IndexModel

@{
    ViewData["Title"] = "Category Management";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Category Management</h1>
        <p class="page-subtitle text-muted">Manage product categories and track items assigned to each group.</p>
    </div>
    <div>
        <a asp-page="Create" class="btn-custom btn-custom-primary">
            <i class="bi bi-plus-lg me-1"></i>Add New Category
        </a>
    </div>
</div>

<!-- Alert Messages -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Main Table Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Total Products</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories == null || !Model.Categories.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="bi bi-folder text-muted fs-3 d-block mb-2"></i>No categories available.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Categories)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Name</td>
                                <td class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                        @(item.Products?.Count ?? 0) Items
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="table-btn-action" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="table-btn-action" title="Edit Category">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="table-btn-action text-danger" title="Delete Category">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>