@page "{id:int}"
@model Inventory.Web.Pages.Category.DeleteModel

@{
    ViewData["Title"] = "Delete Category";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title text-danger">Delete Category</h1>
        <p class="page-subtitle text-muted">Confirm removal of this product group.</p>
    </div>
    <div>
        <a asp-page="Index" class="btn-custom btn-custom-light">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<!-- Main Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <!-- Danger Alert Box -->
        <div class="alert alert-danger border-0 bg-danger-subtle text-danger d-flex align-items-start gap-3 p-3 rounded-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-4 flex-shrink-0"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">Are you sure you want to delete @Model.Category.Name?</h5>
                <p class="mb-0 small">Removing this category may affect items assigned to it. This action cannot be undone.</p>
            </div>
        </div>

        <!-- Details List -->
        <dl class="row mb-4 gy-2">
            <dt class="col-sm-3 text-muted">Category Name</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Category.Name</dd>

            <dt class="col-sm-3 text-muted">Description</dt>
            <dd class="col-sm-9 text-secondary">@(string.IsNullOrEmpty(Model.Category.Description) ? "-" : Model.Category.Description)</dd>

            <dt class="col-sm-3 text-muted">Assigned Products</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                    @(Model.Category.Products?.Count ?? 0) Items
                </span>
            </dd>
        </dl>

        <!-- Form Action -->
        <form method="post">
            <input type="hidden" asp-for="Category.Id" />
            <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                <a asp-page="Index" class="btn-custom btn-custom-light">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 py-2 rounded-2 fw-semibold">
                    <i class="bi bi-trash me-1"></i>Confirm Delete
                </button>
            </div>
        </form>
    </div>
</div>