@page
@model Inventory.Web.Pages.Category.CreateModel

@{
    ViewData["Title"] = "Add New Category";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Add New Category</h1>
        <p class="page-subtitle text-muted">Create a new category to group related products.</p>
    </div>
    <div>
        <a asp-page="Index" class="btn-custom btn-custom-light">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<!-- Main Form Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <!-- Category Name -->
                <div class="col-12">
                    <label asp-for="Category.Name" class="form-label-custom fw-semibold mb-1">Category Name</label>
                    <input asp-for="Category.Name" class="form-control-custom" placeholder="Enter category name" />
                    <span asp-validation-for="Category.Name" class="text-danger small"></span>
                </div>

                <!-- Category Description -->
                <div class="col-12">
                    <label asp-for="Category.Description" class="form-label-custom fw-semibold mb-1">Description</label>
                    <textarea asp-for="Category.Description" class="form-control-custom" rows="3" placeholder="Brief details about this category..."></textarea>
                    <span asp-validation-for="Category.Description" class="text-danger small"></span>
                </div>
            </div>

            <!-- Form Buttons -->
            <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-page="Index" class="btn-custom btn-custom-light">Cancel</a>
                <button type="submit" class="btn-custom btn-custom-primary">
                    <i class="bi bi-plus-lg me-1"></i>Save Category
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}