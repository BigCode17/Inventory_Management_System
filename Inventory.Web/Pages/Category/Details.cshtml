@page "{id:int}"
@model Inventory.Web.Pages.Category.DetailsModel

@{
    ViewData["Title"] = "Category Details";
}

<!-- Page Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Category Details</h1>
        <p class="page-subtitle text-muted">Review category info and linked inventory items.</p>
    </div>
    <div>
        <a asp-page="Index" class="btn-custom btn-custom-light">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<!-- Main Details Container -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center border border-primary-subtle" style="width: 64px; height: 64px;">
                <i class="bi bi-folder fs-3"></i>
            </div>
            <div>
                <h3 class="mb-1 fw-bold">@Model.Category.Name</h3>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                    @(Model.Category.Products?.Count ?? 0) Products Assigned
                </span>
            </div>
        </div>

        <hr class="text-muted my-3" />

        <dl class="row mb-0 gy-3">
            <dt class="col-sm-3 text-muted">Category ID</dt>
            <dd class="col-sm-9 fw-semibold">#@Model.Category.Id</dd>

            <dt class="col-sm-3 text-muted">Category Name</dt>
            <dd class="col-sm-9 fw-semibold text-dark">@Model.Category.Name</dd>

            <dt class="col-sm-3 text-muted">Description</dt>
            <dd class="col-sm-9">
                <div class="p-3 bg-light rounded-3 border text-secondary">
                    @(string.IsNullOrEmpty(Model.Category.Description) ? "No description available." : Model.Category.Description)
                </div>
            </dd>
        </dl>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-page="Index" class="btn-custom btn-custom-light">Back to List</a>
            <a asp-page="./Edit" asp-route-id="@Model.Category.Id" class="btn-custom btn-custom-primary">
                <i class="bi bi-pencil me-1"></i>Edit Category
            </a>
            <a asp-page="./Delete" asp-route-id="@Model.Category.Id" class="btn btn-outline-danger px-3 py-2 rounded-2 fw-semibold">
                <i class="bi bi-trash me-1"></i>Delete
            </a>
        </div>
    </div>
</div>